# Database (Neon) — fill when you create the project
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Clerk — https://dashboard.clerk.com  (or: npx clerk auth login && npx clerk init --login)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Webhook signing secret (Clerk dashboard → Webhooks). Either name works.
CLERK_WEBHOOK_SECRET=
CLERK_WEBHOOK_SIGNING_SECRET=

# Clerk UI routes (branded page is /login)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Soft-lock window after expiry/suspend (days)
SOFT_LOCK_DAYS=3

# First login(s) with these emails become / stay NIVRA_ADMIN (comma-separated)
PLATFORM_ADMIN_EMAIL=yashurade27@gmail.com,prajyot.tayde@nivrafintech.com

# Optional: secure cron purge route later
CRON_SECRET=
